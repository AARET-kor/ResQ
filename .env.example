# Copy this file to .env.local and replace with your real Supabase values.
# The URL must be a syntactically valid https URL or @supabase/supabase-js
# createClient() will throw at startup (and in tests).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Dashboard > Authentication > URL Configuration:
# Site URL: https://resq-medical-workspace.aret.chatgpt.site
# Redirect URLs:
#   https://resq-medical-workspace.aret.chatgpt.site/**
#   http://localhost:5173/**
#   http://127.0.0.1:5173/**
#   resq://auth/callback
#   com.resq.medical://auth/callback
# If these are missing, Supabase silently falls back to Site URL after OAuth.

# Show Sign in with Apple only after the Apple provider is fully configured in
# Supabase Auth and the app/web identifiers are registered with Apple.
# VITE_APPLE_AUTH_ENABLED=false

# Server-side Edge Function secret. Do not expose this as a VITE_ variable.
# Configure with: supabase secrets set OPENALEX_API_KEY=your-key
# Then deploy:    supabase functions deploy paper-discovery
# OPENALEX_API_KEY=your-openalex-key-here

# Calendar/task OAuth and credential vault (Supabase Edge Function secrets,
# never VITE_ values). Generate a long random encryption key once:
# supabase secrets set INTEGRATION_TOKEN_ENCRYPTION_KEY="$(openssl rand -base64 48)"
# Register this callback with Google Cloud, Microsoft Entra, and Todoist:
# https://YOUR_PROJECT.supabase.co/functions/v1/integration-oauth/callback
# The UI discovers enabled providers from the server, so no VITE feature flag
# is needed.
# INTEGRATION_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# MICROSOFT_CLIENT_ID=your-entra-application-client-id
# MICROSOFT_CLIENT_SECRET=your-entra-client-secret
# TODOIST_CLIENT_ID=your-todoist-client-id
# TODOIST_CLIENT_SECRET=your-todoist-client-secret
