# Copy this file to .env.local and replace with your real Supabase values.
# The URL must be a syntactically valid https URL or @supabase/supabase-js
# createClient() will throw at startup (and in tests).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Show Sign in with Apple only after the Apple provider is fully configured in
# Supabase Auth and the app/web identifiers are registered with Apple.
# VITE_APPLE_AUTH_ENABLED=false

# Server-side Edge Function secret. Do not expose this as a VITE_ variable.
# Configure with: supabase secrets set OPENALEX_API_KEY=your-key
# Then deploy:    supabase functions deploy paper-discovery
# OPENALEX_API_KEY=your-openalex-key-here

# Microsoft Graph OAuth (Supabase Edge Function secrets, never VITE_ values).
# Register this callback in Microsoft Entra:
# https://YOUR_PROJECT.supabase.co/functions/v1/integration-oauth/callback
# Configure with:
# supabase secrets set MICROSOFT_CLIENT_ID=... MICROSOFT_CLIENT_SECRET=...
# Enable the web UI after both secrets and callback registration are complete.
# VITE_MICROSOFT_INTEGRATION_ENABLED=false
# MICROSOFT_CLIENT_ID=your-entra-application-client-id
# MICROSOFT_CLIENT_SECRET=your-entra-client-secret
